# Playwright MCP server (Coolify/Traefik)
PLAYWRIGHT_MCP_HOST=0.0.0.0
PLAYWRIGHT_MCP_PORT=8931
PLAYWRIGHT_MCP_ALLOWED_HOSTS=*
PLAYWRIGHT_MCP_ALLOWED_ORIGINS=*

# Browserless CDP endpoint (required in production)
PLAYWRIGHT_MCP_CDP_ENDPOINT=wss://browserless.example.com?token=REDACTED

# Optional CDP headers (JSON or key:value;key:value)
# PLAYWRIGHT_MCP_CDP_HEADERS={"x-api-key":"REDACTED"}
# PLAYWRIGHT_MCP_CDP_HEADERS=x-api-key:REDACTED;x-client:playwright-mcp

# Optional: reuse the same browser context across HTTP clients
PLAYWRIGHT_MCP_SHARED_BROWSER_CONTEXT=true
